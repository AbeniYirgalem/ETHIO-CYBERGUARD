# -----------------------------------------------------------------------------
# ETHIO-CYBERGUARD Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Database
POSTGRES_USER=ecg_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=ethio_cyberguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecg_admin:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/ethio_cyberguard

# Redis & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
AGENT_AUTH_TOKEN=CHANGE_ME_GENERATE_RANDOM_TOKEN

# Shared key collectors use to send events to /api/v1/events/ingest. Required, no default.
INGEST_API_KEY=CHANGE_ME_GENERATE_RANDOM_KEY

# Set to false for any real deployment. true shows the demo banner and allows mock data.
DEMO_MODE=true

# AI & LLM Providers (Optional for enhanced live reasoning)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_OLLAMA_URL=http://localhost:11434

# Ingestion Collectors
SYSLOG_PORT=5140
WINDOWS_COLLECTOR_POLL_INTERVAL=5

# Platform Tenant Details
ORG_NAME="Commercial Bank of Ethiopia (CBE)"
ORG_SECTOR="Banking"
ORG_LOCATION="Addis Ababa, Ethiopia"

# -----------------------------------------------------------------------------
# ETHIO-CYBERGUARD Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Database
POSTGRES_USER=ecg_admin
POSTGRES_PASSWORD=SecOpsPassw0rd_2026!
POSTGRES_DB=ethio_cyberguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecg_admin:SecOpsPassw0rd_2026!@localhost:5432/ethio_cyberguard

# Redis & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API Configuration
# DEMO_MODE=true  : simulated data + guest access (public demo only)
# DEMO_MODE=false : production. Requires real secrets below (app refuses to start otherwise)
DEMO_MODE=true
# Keep incidents, SOAR actions and the audit log across restarts (SQLite locally, Postgres via DATABASE_URL).
# Use a single API worker per database.
PERSISTENCE_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
INGEST_API_KEY=
# Which organization the shared INGEST_API_KEY belongs to (default: Commercial Bank of Ethiopia).
# INGEST_DEFAULT_ORG=org_cbe_01
# One collector key per organization (each 16+ characters), as key:organization pairs, comma separated.
# A collector can never choose its organization; the key decides it.
# INGEST_ORG_KEYS=replace-with-random-key-1:org_awash_bank,replace-with-random-key-2:org_telebirr
# First administrator for production (DEMO_MODE=false has NO built-in accounts).
# Password: 12+ characters mixing at least three of lower/upper/digits/symbols.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Self-service password reset (token is written to the server log until email/SMS is connected)
PASSWORD_RESET_ENABLED=true
# PBKDF2 work factor for newly created passwords (default 600000)
# PASSWORD_HASH_ITERATIONS=600000
API_PORT=8000
API_HOST=0.0.0.0
API_SECRET_KEY=ecg_development_jwt_secret_key_change_in_prod
AGENT_AUTH_TOKEN=ecg_agent_token_dev_secret

# AI & LLM Providers (Optional for enhanced live reasoning)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_OLLAMA_URL=http://localhost:11434

# Ingestion Collectors
SYSLOG_PORT=5140
WINDOWS_COLLECTOR_POLL_INTERVAL=5

# Platform Tenant Details
ORG_NAME="Commercial Bank of Ethiopia (CBE)"
ORG_SECTOR="Banking"
ORG_LOCATION="Addis Ababa, Ethiopia"

# Refresh tokens are single-use. Reuse after this many seconds revokes that whole login session.
REFRESH_REUSE_GRACE_SECONDS=10

# --- HTTP hardening (apps/api/security_middleware.py) ---
# Per-IP limit on login / refresh / password-reset. Default: on in production, off in demo mode.
# AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
# Only true when the API sits behind a reverse proxy you control (reads X-Forwarded-For).
TRUST_PROXY=false
# Strict-Transport-Security header. Default: on in production, off in demo mode. Serve over HTTPS first.
# ENABLE_HSTS=true

# --- docker-compose.prod.yml only ---
# ALLOWED_ORIGINS=https://soc.example.org
# PUBLIC_API_URL=https://api.example.org

# -----------------------------------------------------------------------------
# ETHIO-CYBERGUARD Environment Configuration Template
# -----------------------------------------------------------------------------

# Deployment Environment: "production" or "development"
# In production, default/insecure passwords and DEMO_MODE=true are rejected at startup.
ENVIRONMENT=development

# Mode Separation
# Set to false for any real deployment. In demo mode (true), mock fallbacks and sample logins are enabled.
DEMO_MODE=true

# PostgreSQL Database
POSTGRES_USER=ecg_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=ethio_cyberguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecg_admin:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/ethio_cyberguard

# Redis & Message Broker
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD_MIN_16_CHARS
POSTGRES_DB=ethio_cyberguard
DATABASE_URL=postgresql://ecg_admin:CHANGE_ME_STRONG_DATABASE_PASSWORD_MIN_16_CHARS@localhost:5432/ethio_cyberguard

# Redis & Message Broker (with authentication required)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_MIN_16_CHARS
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD_MIN_16_CHARS@localhost:6379/0

# Backend API Configuration
# DEMO_MODE=true  : simulated data + guest access (public demo only)
# DEMO_MODE=false : production. Requires real secrets below (app refuses to start otherwise)
DEMO_MODE=true
# Keep incidents, SOAR actions and the audit log across restarts (SQLite locally, Postgres via DATABASE_URL).
# Use a single API worker per database.
PERSISTENCE_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
INGEST_API_KEY=
# Which organization the shared INGEST_API_KEY belongs to (default: Commercial Bank of Ethiopia).
# INGEST_DEFAULT_ORG=org_cbe_01
# One collector key per organization (each 16+ characters), as key:organization pairs, comma separated.
# A collector can never choose its organization; the key decides it.
# INGEST_ORG_KEYS=replace-with-random-key-1:org_awash_bank,replace-with-random-key-2:org_telebirr
# First administrator for production (DEMO_MODE=false has NO built-in accounts).
# Password: 12+ characters mixing at least three of lower/upper/digits/symbols.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Self-service password reset (token is written to the server log until email/SMS is connected)
PASSWORD_RESET_ENABLED=true
# PBKDF2 work factor for newly created passwords (default 600000)
# PASSWORD_HASH_ITERATIONS=600000
# Backend API & Authentication Secrets
# Generate random keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_PORT=8000
API_HOST=0.0.0.0
API_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_JWT_SECRET_MIN_32_CHARS
AGENT_AUTH_TOKEN=CHANGE_ME_GENERATE_RANDOM_AGENT_AUTH_TOKEN

# Collector Ingestion Key
# Shared key endpoint agents use to send events to /api/v1/events/ingest. Required in production.
INGEST_API_KEY=CHANGE_ME_COLLECTOR_INGESTION_SECRET_KEY

# Token Expiry Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ingestion Protections
MAX_PAYLOAD_BYTES=2097152
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://AbeniYirgalem.github.io

# AI & LLM Providers (Optional for enhanced live reasoning; deterministic SIGMA rule detection remains functional without external keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_OLLAMA_URL=http://localhost:11434

# Ingestion Collectors
SYSLOG_PORT=5140
WINDOWS_COLLECTOR_POLL_INTERVAL=5

# Platform Tenant Details
ORG_NAME="Commercial Bank of Ethiopia (CBE)"
ORG_SECTOR="Banking"
ORG_LOCATION="Addis Ababa, Ethiopia"

# Refresh tokens are single-use. Reuse after this many seconds revokes that whole login session.
REFRESH_REUSE_GRACE_SECONDS=10

# Where login rate limits and token revocation are kept so several API workers agree.
# auto = Redis in production (DEMO_MODE=false) when REDIS_URL is set, otherwise this process only.
# SHARED_STATE_BACKEND=auto   # auto | redis | memory

# --- HTTP hardening (apps/api/security_middleware.py) ---
# Per-IP limit on login / refresh / password-reset. Default: on in production, off in demo mode.
# AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
# Only true when the API sits behind a reverse proxy you control (reads X-Forwarded-For).
TRUST_PROXY=false
# Strict-Transport-Security header. Default: on in production, off in demo mode. Serve over HTTPS first.
# ENABLE_HSTS=true

# --- docker-compose.prod.yml only ---
# ALLOWED_ORIGINS=https://soc.example.org
# PUBLIC_API_URL=https://api.example.org

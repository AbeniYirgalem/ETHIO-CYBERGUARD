{
  "name": "ethio-cyberguard",
  "version": "1.1.0",
  "description": "AI-Assisted Cybersecurity Platform for Threat Detection, Investigation, and Incident Response",
  "private": true,
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "python -m uvicorn apps.api.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "npm run build --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "preview:web": "npm run preview --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "lint:web": "npm run lint --prefix apps/web",
    "test": "python -m pytest tests/ -v",
    "test:api": "python -m pytest tests/ -v"
  },
  "keywords": [
    "soc",
    "siem",
    "cybersecurity",
    "ai",
    "multi-agent",
    "incident-response",
    "ethiopia"
  ],
  "author": "ETHIO-CYBERGUARD Contributors",
  "license": "Apache-2.0"
}
